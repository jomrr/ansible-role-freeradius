# Managed by ansible.
# file: {{ template_destpath }}

prefix = /usr
name = {{ __freeradius_service }}
libdir = {{ __freeradius_lib_dir }}
run_dir = {{ __freeradius_run_dir }}
pidfile = ${run_dir}/${name}.pid
hostname_lookups = no
max_request_time = 30
max_requests = 16384
cleanup_delay = 5
proxy_requests = no

log {
    destination = syslog
    syslog_facility = daemon
    auth = yes
    auth_badpass = no
    auth_goodpass = no
}

security {
    user = {{ __freeradius_user }}
    group = {{ __freeradius_group }}
    allow_core_dumps = no
    max_attributes = 200
    reject_delay = 1
    status_server = no
}

thread pool {
    start_servers = 2
    max_servers = 16
    min_spare_servers = 1
    max_spare_servers = 4
}

{% for __freeradius_client in freeradius_clients %}
client {{ __freeradius_client.name }} {
    ipaddr = {{ __freeradius_client.address }}
    secret = "{{ __freeradius_client.secret }}"
    require_message_authenticator = yes
}

{% endfor %}
{% if freeradius_accounting_enabled %}
policy {
    # Defined here because distribution policy.d files are not loaded.
    acct_unique {
        # NAS-Identifier alone is valid; PostgreSQL also needs a NAS address.
        update request {
            NAS-IP-Address = "%{Packet-Src-IP-Address}"
        }
        update request {
            Acct-Unique-Session-Id := "%{md5:%{User-Name},%{Acct-Session-Id},%{NAS-IP-Address},%{NAS-Identifier},%{NAS-Port-ID},%{NAS-Port}}"
            # Preserve the NAS timestamp; otherwise record receipt minus NAS delay.
{% raw %}            Event-Timestamp = "%{expr:%l - %{%{Acct-Delay-Time}:-0}}"
{% endraw %}
        }
    }
}

{% endif %}
modules {
    files {
        filename = {{ __freeradius_config_dir }}/ansible-users
    }
{% if freeradius_eap_tls_enabled %}
    eap {
        default_eap_type = tls
        ignore_unknown_eap_types = no
        tls-config tls-certificate {
            private_key_file = "{{ freeradius_eap_tls_private_key_file }}"
            private_key_password = "{{ freeradius_eap_tls_private_key_password }}"
            certificate_file = "{{ freeradius_eap_tls_certificate_file }}"
            ca_file = "{{ freeradius_eap_tls_ca_file }}"
            auto_chain = no
            check_cert_issuer = "{{ freeradius_eap_tls_issuer }}"
            tls_min_version = "1.2"
            tls_max_version = "1.3"
            cache {
                enable = no
            }
{% if freeradius_eap_tls_revocation == 'crl' %}
            ca_path = "{{ freeradius_eap_tls_ca_path }}"
            check_crl = yes
            check_all_crl = yes
            allow_expired_crl = no
            ca_path_reload_interval = 300
{% elif freeradius_eap_tls_revocation == 'ocsp' %}
            ocsp {
                enable = yes
                override_cert_url = yes
                url = "{{ freeradius_eap_tls_ocsp_url }}"
                use_nonce = yes
                timeout = 5
                softfail = no
            }
{% endif %}
        }
        tls {
            tls = tls-certificate
            virtual_server = check-eap-tls
        }
    }
{% endif %}
    pap {
        normalise = yes
    }
    always reject {
        rcode = reject
    }
{% if freeradius_accounting_enabled %}
    expr {
    }
    detail {
        filename = "{{ __freeradius_log_dir }}/ansible-accounting/detail-%Y%m%d"
        permissions = 0600
        locking = yes
    }
{% endif %}
{% if freeradius_accounting_backend == 'postgresql' %}
    always ok {
        rcode = ok
    }
    sql {
        dialect = postgresql
        driver = rlm_sql_postgresql
        server = "{{ freeradius_postgresql_host }}"
        port = {{ freeradius_postgresql_port }}
        login = "{{ freeradius_postgresql_user }}"
        password = "{{ freeradius_postgresql_password }}"
        radius_db = "dbname='{{ freeradius_postgresql_database }}' sslmode={{ freeradius_postgresql_ssl_mode }}{% if freeradius_postgresql_ssl_root_cert %} sslrootcert='{{ freeradius_postgresql_ssl_root_cert }}'{% endif %}"
        query_timeout = 5
        read_clients = no
        read_groups = no
        read_profiles = no
        delete_stale_sessions = no
        acct_table1 = radacct
        acct_table2 = radacct
        postauth_table = radpostauth
        authcheck_table = radcheck
        authreply_table = radreply
        groupcheck_table = radgroupcheck
        groupreply_table = radgroupreply
        usergroup_table = radusergroup
        client_table = nas
        group_attribute = SQL-Group
        pool {
            # No startup connection: an unavailable database must not stop RADIUS.
            start = 0
            min = 0
            max = 4
            spare = 1
            retry_delay = 5
            idle_timeout = 60
        }
        $INCLUDE {{ __freeradius_config_dir }}/mods-config/sql/main/postgresql/queries.conf
    }
{% endif %}
    cache login_attempts {
        driver = "rlm_cache_rbtree"
        key = "%{User-Name}"
        ttl = {{ freeradius_failure_window }}
        add_stats = yes
        update {
            &control:Tmp-String-0 := "password_check"
        }
    }
    linelog auth_audit {
        filename = syslog
        syslog_facility = authpriv
        syslog_severity = info
        format = "event=radius_auth result=%{reply:Packet-Type} user_hex=%{hex:&User-Name} client=%{client:shortname} source=%{Packet-Src-IP-Address} stage=%{control:Tmp-String-0}"
    }
}

server default {
    listen {
        type = auth
        ipaddr = {{ freeradius_listen_address }}
        port = {{ freeradius_port }}
    }
{% if freeradius_accounting_enabled %}
    listen {
        type = acct
        ipaddr = {{ freeradius_listen_address }}
        port = {{ freeradius_accounting_port }}
    }
    preacct {
        acct_unique
    }
    accounting {
        # The native accounting handler sends no response on fail/invalid/noop.
        detail
    }
{% endif %}
    authorize {
        update control {
            Tmp-String-0 := "unknown_user"
        }
{% if freeradius_eap_tls_enabled %}
        if (&request:EAP-Message) {
            update control {
                Tmp-String-0 := "eap_tls"
            }
            eap
            return
        }
{% endif %}
        files
        # Only configured users allocate cache entries; no credentials are cached.
        if (&control:Crypt-Password || &control:PBKDF2-Password || &control:SSHA2-512-Password || &control:NT-Password || &control:Cleartext-Password) {
            # The rbtree mutex serializes hit increments, including parallel requests.
            login_attempts {
                fail = 1
            }
            if (fail) {
                update control {
                    Tmp-String-0 := "cache_error"
                }
                reject
            }
            # A new entry has zero hits and represents the first admitted attempt.
            if (&request:Cache-Entry-Hits >= {{ freeradius_failure_limit }}) {
                update control {
                    Tmp-String-0 := "rate_limit"
                }
                reject
            }
        }
        # FreeRADIUS 3 does not infer Auth-Type from PBKDF2-Password.
        if (&request:User-Password && &control:PBKDF2-Password) {
            update control {
                Auth-Type := PAP
            }
        }
        pap
    }
    authenticate {
{% if freeradius_eap_tls_enabled %}
        eap
{% endif %}
        Auth-Type PAP {
            pap
        }
    }
    post-auth {
        if (!&request:EAP-Message) {
{% if freeradius_simultaneous_use > 0 %}
            # SQL xlat escapes interpolated attributes. An empty result means failure.
            update control {
                Simultaneous-Use := {{ freeradius_simultaneous_use }}
                Tmp-String-1 := "%{sql:SELECT COUNT(*) FROM radacct WHERE username='%{User-Name}' AND acctstoptime IS NULL}"
            }
            if (&control:Tmp-String-1 !~ /^[0-9]+$/) {
                update control {
                    Tmp-String-0 := "session_database_error"
                }
                reject
            }
            update control {
                Tmp-Integer-0 := &control:Tmp-String-1
            }
            if (&control:Tmp-Integer-0 >= &control:Simultaneous-Use) {
                update control {
                    Tmp-String-0 := "simultaneous_use"
                }
                reject
            }
{% endif %}
            # Read-only prevents concurrent successful requests recreating a deleted entry.
            update control {
                Cache-TTL := 0
                Cache-Read-Only := yes
            }
            login_attempts
        }
        auth_audit
        Post-Auth-Type REJECT {
{% if freeradius_eap_tls_enabled %}
            eap
{% endif %}
            auth_audit
        }
    }
}
{% if freeradius_accounting_backend == 'postgresql' %}

server buffered-sql {
    listen {
        type = detail
        filename = "{{ __freeradius_log_dir }}/ansible-accounting/detail-*"
        load_factor = 10
        poll_interval = 1
        retry_interval = 5
        track = yes
    }
    accounting {
        sql {
            noop = 1
        }
        # NAS restart events may successfully affect no sessions. Retain other noops.
        if (noop && (&Acct-Status-Type == Accounting-On || &Acct-Status-Type == Accounting-Off)) {
            ok
        }
    }
}
{% endif %}

{% if freeradius_eap_tls_enabled %}
server check-eap-tls {
    authorize {
        # The TLS module has verified the chain, validity and configured issuer.
        if (!&TLS-Client-Cert-X509v3-Extended-Key-Usage-OID || !(&TLS-Client-Cert-X509v3-Extended-Key-Usage-OID[*] == "1.3.6.1.5.5.7.3.2")) {
            reject
        }
        # Only unqualified numeric policies are accepted. Qualifier text must not
        # impersonate policy entries in OpenSSL's human-readable extension output.
        if (!&TLS-Client-Cert-X509v3-Certificate-Policies || &TLS-Client-Cert-X509v3-Certificate-Policies !~ /^Policy: [0-9.]+(\nPolicy: [0-9.]+)*\n?$/) {
            reject
        }
        if ("%{strlen:&TLS-Client-Cert-X509v3-Certificate-Policies}" >= 1023) {
            reject
        }
{% for __freeradius_policy in freeradius_eap_tls_vlan_policies %}
        if (&TLS-Client-Cert-X509v3-Certificate-Policies =~ /(^|\n)Policy: {{ __freeradius_policy.oid | regex_escape }}(\n|$)/) {
            if (&control:Tmp-Integer-1) {
                reject
            }
            update control {
                Tmp-Integer-1 := {{ __freeradius_policy.vlan_id }}
            }
        }
{% endfor %}
        if (!&control:Tmp-Integer-1) {
            reject
        }
        update reply {
            Tunnel-Type := VLAN
            Tunnel-Medium-Type := IEEE-802
            Tunnel-Private-Group-Id := "%{control:Tmp-Integer-1}"
        }
        update control {
            Auth-Type := Accept
        }
    }
}
{% endif %}
